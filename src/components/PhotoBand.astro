---
// Full-bleed photograph between sections. The image fades into the sections around it
// (CSS mask), so `above` / `below` name those sections' backgrounds: the band paints a
// gradient between them behind the faded edges. fade: which edges fade. size: band height.
// Optional overlay (eyebrow + text) turns it into a full-bleed statement over the image.
// No on-image credit: the photographers gave consent without one (Cooper, 2026-11-26).
import { Picture } from 'astro:assets';
import type { Photo } from '../data/photos';
type Bg = 'ivory' | 'alt';
interface Props {
  photo: Photo;
  eyebrow?: string;
  text?: string;
  fade?: 'both' | 'top' | 'none';
  size?: 'default' | 'short' | 'thin';
  above?: Bg;
  below?: Bg;
}
const { photo, eyebrow, text, fade = 'both', size = 'default', above = 'ivory', below = 'ivory' } = Astro.props;
const overlay = Boolean(text);
const bg = (b: Bg) => (b === 'alt' ? 'var(--candle-white)' : 'var(--ivory)');
---
<figure
  class:list={['photo-band', `photo-band-${size}`, { 'photo-band-overlay': overlay, [`photo-band-fade-${fade}`]: fade !== 'none' }]}
  style={`--band-above: ${bg(above)}; --band-below: ${bg(below)}`}
>
  <div class="photo-band-frame">
    <Picture
      src={photo.src}
      alt={photo.alt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600, 1920]}
      quality={55}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      style={photo.focus ? `object-position: ${photo.focus}` : undefined}
    />
    {overlay && (
      <div class="photo-band-text container">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <p class="photo-band-statement">{text}</p>
      </div>
    )}
  </div>
</figure>
