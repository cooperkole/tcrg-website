---
// One person. Names of "TBD" (or containing it) render as placeholder cards.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { name: string; role?: string; bio?: string; photo?: string; linkedin?: string; joined?: string; compact?: boolean }
const { name, role, bio, photo, linkedin, joined, compact = false } = Astro.props;

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/headshots/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const src = photo ? shots[`../assets/headshots/${photo}`]?.default : undefined;

const isTbd = /\bTBD\b/.test(name);
const initials = name.split(/\s+/).filter((w) => w && w !== 'TBD').map((w) => w[0]).slice(0, 2).join('');
const displayName = name === 'TBD' ? 'Name TBD' : name;
---
<article class:list={['person', { 'person-compact': compact, 'person-tbd': isTbd }]}>
  <div class="person-photo">
    {src
      ? <Image src={src} alt={name} width={480} height={600} fit="cover" />
      : <span class="monogram" aria-hidden="true">{initials}</span>}
  </div>
  <h3 class="person-name">{displayName}</h3>
  {role && <p class="person-role">{role}</p>}
  {joined && <p class="person-joined">Joined {joined}</p>}
  {!compact && <p class="person-bio">{bio || 'Bio coming soon.'}</p>}
  {linkedin && <a class="person-link" href={linkedin} rel="noopener">LinkedIn</a>}
</article>
