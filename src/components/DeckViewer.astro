---
// Slide viewer for one deck in src/data/decks.json. Images come from
// scripts/build-deck.mjs (view 1600px, zoom 2800px, thumb 320px WebP).
// Controls: prev/next buttons, arrow keys, thumbnails, fullscreen, zoom
// (ctrl/pinch wheel, two-finger pinch, double-click, +/-/0 keys), drag to pan,
// swipe on touch, deep link ?slide=N. Only the current slide and its two
// neighbours are fetched; zoom images load only when zooming.
import { withBase } from '../lib/paths';

interface Props { deck: { id: string; title: string; subtitle?: string; term: string; date: string; pages: number; width: number; height: number; folder: string; summary: string; sections: { title: string; slide: number; text: string }[] } }
const { deck } = Astro.props;
const nn = (n: number) => String(n).padStart(2, '0');
const base = withBase(`/${deck.folder}`);
const label = (n: number) => `${deck.title} deck, slide ${n} of ${deck.pages}`;
const slides = Array.from({ length: deck.pages }, (_, i) => i + 1);
---
<div class="deck" data-deck data-base={base} data-pages={deck.pages} data-title={deck.title} id="deck">
  <div class="deck-head">
    <div>
      <p class="deck-meta">{deck.term} · {deck.pages} slides · Redacted</p>
      <h3 class="deck-title">{deck.title}{deck.subtitle && <span>: {deck.subtitle}</span>}</h3>
    </div>
    <p class="deck-hint muted">Swipe or use the arrow keys. Pinch or double-click to zoom.</p>
  </div>

  <div class="deck-stage" data-stage tabindex="0" role="region" aria-roledescription="slide viewer" aria-label={`${deck.title} deck`}>
    <div class="deck-canvas" data-canvas>
      <img data-slide src={`${base}/view/01.webp`} width={deck.width} height={deck.height} alt={label(1)} aria-label={label(1)} draggable="false" decoding="async" fetchpriority="low" />
    </div>
    <button class="deck-nav deck-prev" type="button" data-prev aria-label="Previous slide" disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button class="deck-nav deck-next" type="button" data-next aria-label="Next slide">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>

  <div class="deck-bar">
    <p class="deck-count" aria-live="polite" data-count><span data-current>1</span> / {deck.pages}</p>
    <div class="deck-tools">
      <button type="button" class="deck-tool" data-zoom-out aria-label="Zoom out" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg></button>
      <button type="button" class="deck-tool" data-zoom-in aria-label="Zoom in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg></button>
      <button type="button" class="deck-tool" data-fullscreen aria-label="Enter full screen" aria-pressed="false">
        <svg class="fs-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
        <svg class="fs-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" /></svg>
      </button>
    </div>
  </div>

  <ol class="deck-thumbs" data-thumbs aria-label="All slides">
    {slides.map((n) => (
      <li>
        <a href={`?slide=${n}#deck`} data-goto={n} aria-label={`Go to slide ${n}`} aria-current={n === 1 ? 'true' : undefined}>
          <img src={`${base}/thumb/${nn(n)}.webp`} width="320" height="180" alt="" loading="lazy" decoding="async" />
          <span aria-hidden="true">{n}</span>
        </a>
      </li>
    ))}
  </ol>

  <div class="deck-summary">
    <div>
      <h4>About this deck</h4>
      <p>{deck.summary}</p>
      <p class="muted">Delivered {deck.date}. Client details are redacted.</p>
    </div>
    <ol class="deck-sections" aria-label="Deck sections">
      {deck.sections.map((s) => (
        <li>
          <a href={`?slide=${s.slide}#deck`} data-goto={s.slide}><span class="deck-section-title">{s.title}</span><span class="deck-section-slide">Slide {s.slide}</span></a>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</div>

<script>
  const MAX = 4;
  for (const root of document.querySelectorAll<HTMLElement>('[data-deck]')) {
    const base = root.dataset.base!;
    const pages = Number(root.dataset.pages);
    const title = root.dataset.title!;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const canvas = root.querySelector<HTMLElement>('[data-canvas]')!;
    const img = root.querySelector<HTMLImageElement>('[data-slide]')!;
    const current = root.querySelector<HTMLElement>('[data-current]')!;
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const zin = root.querySelector<HTMLButtonElement>('[data-zoom-in]')!;
    const zout = root.querySelector<HTMLButtonElement>('[data-zoom-out]')!;
    const fsBtn = root.querySelector<HTMLButtonElement>('[data-fullscreen]')!;
    const thumbs = [...root.querySelectorAll<HTMLAnchorElement>('[data-thumbs] a')];
    const nn = (n: number) => String(n).padStart(2, '0');
    const src = (n: number, size: 'view' | 'zoom') => `${base}/${size}/${nn(n)}.webp`;
    const label = (n: number) => `${title} deck, slide ${n} of ${pages}`;
    const warm = new Set<string>();
    const preload = (u: string) => { if (!warm.has(u)) { warm.add(u); const i = new Image(); i.decoding = 'async'; i.src = u; } };

    let n = 1, s = 1, tx = 0, ty = 0;

    // ---- Zoom and pan ----
    const clamp = () => {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      tx = Math.min(0, Math.max(w - w * s, tx));
      ty = Math.min(0, Math.max(h - h * s, ty));
    };
    const apply = () => {
      clamp();
      img.style.transform = s === 1 ? '' : `translate(${tx}px, ${ty}px) scale(${s})`;
      root.classList.toggle('is-zoomed', s > 1);
      zout.disabled = s <= 1; zin.disabled = s >= MAX;
      if (s > 1 && !img.src.includes('/zoom/')) img.src = src(n, 'zoom');
    };
    const zoomAt = (next: number, px?: number, py?: number) => {
      next = Math.min(MAX, Math.max(1, next));
      const x = px ?? canvas.clientWidth / 2, y = py ?? canvas.clientHeight / 2;
      tx = x - (x - tx) * (next / s);
      ty = y - (y - ty) * (next / s);
      s = next;
      if (s === 1) { tx = 0; ty = 0; }
      apply();
    };
    const point = (e: { clientX: number; clientY: number }) => {
      const r = canvas.getBoundingClientRect();
      return [e.clientX - r.left, e.clientY - r.top] as const;
    };

    // ---- Navigation ----
    const go = (to: number, { focusThumb = false, push = true } = {}) => {
      to = Math.min(pages, Math.max(1, Math.round(to) || 1));
      const changed = to !== n;
      n = to;
      s = 1; tx = 0; ty = 0;
      img.src = src(n, 'view');
      img.alt = label(n); img.setAttribute('aria-label', label(n));
      apply();
      current.textContent = String(n);
      prevBtn.disabled = n === 1; nextBtn.disabled = n === pages;
      thumbs.forEach((t, i) => (i === n - 1 ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      const t = thumbs[n - 1];
      const strip = t.closest('ol')!;
      strip.scrollTo({ left: t.offsetLeft - strip.clientWidth / 2 + t.offsetWidth / 2, behavior: 'auto' });
      if (focusThumb) t.focus();
      if (n > 1) preload(src(n - 1, 'view'));
      if (n < pages) preload(src(n + 1, 'view'));
      if (push && changed) {
        const u = new URL(location.href);
        u.searchParams.set('slide', String(n));
        history.replaceState(history.state, '', u.pathname + u.search + u.hash);
      }
    };

    prevBtn.addEventListener('click', () => go(n - 1));
    nextBtn.addEventListener('click', () => go(n + 1));
    zin.addEventListener('click', () => zoomAt(s * 1.6));
    zout.addEventListener('click', () => zoomAt(s / 1.6));
    root.querySelectorAll<HTMLAnchorElement>('[data-goto]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        go(Number(a.dataset.goto), { focusThumb: a.closest('[data-thumbs]') !== null });
        if (!a.closest('[data-thumbs]')) { stage.scrollIntoView({ block: 'center', behavior: 'auto' }); stage.focus({ preventScroll: true }); }
      }),
    );

    root.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      const k = e.key;
      if (k === 'ArrowRight' || k === 'PageDown') { e.preventDefault(); go(n + 1, { focusThumb: !!(e.target as Element).closest('[data-thumbs]') }); }
      else if (k === 'ArrowLeft' || k === 'PageUp') { e.preventDefault(); go(n - 1, { focusThumb: !!(e.target as Element).closest('[data-thumbs]') }); }
      else if (k === 'Home' && e.target === stage) { e.preventDefault(); go(1); }
      else if (k === 'End' && e.target === stage) { e.preventDefault(); go(pages); }
      else if ((k === '+' || k === '=') && e.target === stage) { e.preventDefault(); zoomAt(s * 1.6); }
      else if (k === '-' && e.target === stage) { e.preventDefault(); zoomAt(s / 1.6); }
      else if (k === '0' && e.target === stage) { e.preventDefault(); zoomAt(1); }
      else if (k === 'Escape' && root.classList.contains('is-pseudo-fs')) { e.preventDefault(); toggleFs(); }
    });

    // Wheel: trackpad pinch (ctrlKey) always zooms; plain wheel zooms only in full screen
    // so the page keeps scrolling normally past the viewer.
    stage.addEventListener('wheel', (e) => {
      if (!e.ctrlKey && !isFs()) return;
      e.preventDefault();
      const [x, y] = point(e);
      zoomAt(s * Math.exp(-e.deltaY * (e.ctrlKey ? 0.01 : 0.002)), x, y);
    }, { passive: false });

    stage.addEventListener('dblclick', (e) => {
      if ((e.target as Element).closest('button')) return;
      const [x, y] = point(e);
      zoomAt(s > 1 ? 1 : 2.5, x, y);
    });

    // Pointer: one finger/mouse pans when zoomed, swipes when not; two fingers pinch.
    const ptrs = new Map<number, { x: number; y: number }>();
    let start: { x: number; y: number; tx: number; ty: number; t: number } | null = null;
    let pinch: { d: number; s: number } | null = null;
    const dist = () => { const [a, b] = [...ptrs.values()]; return Math.hypot(a.x - b.x, a.y - b.y); };
    canvas.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      canvas.setPointerCapture(e.pointerId);
      ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (ptrs.size === 1) start = { x: e.clientX, y: e.clientY, tx, ty, t: performance.now() };
      if (ptrs.size === 2) { pinch = { d: dist(), s }; start = null; }
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!ptrs.has(e.pointerId)) return;
      ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pinch && ptrs.size === 2) {
        const [a, b] = [...ptrs.values()];
        const [x, y] = point({ clientX: (a.x + b.x) / 2, clientY: (a.y + b.y) / 2 });
        zoomAt(pinch.s * (dist() / pinch.d), x, y);
      } else if (start && s > 1) {
        tx = start.tx + (e.clientX - start.x); ty = start.ty + (e.clientY - start.y);
        root.classList.add('is-panning');
        apply();
      }
    });
    const end = (e: PointerEvent) => {
      if (!ptrs.has(e.pointerId)) return;
      ptrs.delete(e.pointerId);
      if (start && s === 1 && e.pointerType !== 'mouse') {
        const dx = e.clientX - start.x, dy = e.clientY - start.y;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5 && performance.now() - start.t < 800) go(dx < 0 ? n + 1 : n - 1);
      }
      if (ptrs.size < 2) pinch = null;
      if (ptrs.size === 0) { start = null; root.classList.remove('is-panning'); }
    };
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointercancel', end);

    // ---- Full screen (native where supported; CSS overlay on iOS Safari) ----
    const isFs = () => document.fullscreenElement === root || root.classList.contains('is-pseudo-fs');
    const syncFs = () => {
      const on = isFs();
      fsBtn.setAttribute('aria-pressed', String(on));
      fsBtn.setAttribute('aria-label', on ? 'Exit full screen' : 'Enter full screen');
      root.classList.toggle('is-fs', on);
      zoomAt(1);
    };
    const toggleFs = () => {
      if (root.requestFullscreen && document.fullscreenEnabled) {
        if (document.fullscreenElement) document.exitFullscreen(); else root.requestFullscreen().catch(() => {});
      } else {
        root.classList.toggle('is-pseudo-fs');
        document.documentElement.classList.toggle('deck-lock', root.classList.contains('is-pseudo-fs'));
        syncFs();
      }
      stage.focus({ preventScroll: true });
    };
    fsBtn.addEventListener('click', toggleFs);
    document.addEventListener('fullscreenchange', syncFs);
    window.addEventListener('resize', () => apply());

    root.classList.add('is-ready');
    const start0 = Number(new URL(location.href).searchParams.get('slide'));
    go(start0 >= 1 && start0 <= pages ? start0 : 1, { push: false });
    if (start0 > 1 && !location.hash) root.scrollIntoView({ block: 'start' });
  }
</script>
