---
// Client logo bar: scrolls right to left, pauses on hover, static for reduced motion.
// Never mapped to projects or sectors (see clients.json _note).
// Logo: set "logo" in clients.json to a file in src/assets/clients/; otherwise a wordmark shows.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import data from '../data/clients.json';

const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/clients/*.{png,jpg,jpeg,webp,avif,svg}', { eager: true });
const named = data.clients.filter((c) => !c.anonymous);
const anon = data.clients.filter((c) => c.anonymous);
// Optical sizing: wide wordmarks get shorter, stacked marks taller, so all read at a similar visual weight.
const logoHeight = (m: ImageMetadata) => {
  const ratio = m.width / m.height;
  return Math.min(4, Math.max(1.6, 2.6 * Math.sqrt(4 / ratio))).toFixed(2) + 'rem';
};
const items = named.map((c) => {
  const src = c.logo ? logos[`../assets/clients/${c.logo}`]?.default : undefined;
  return { ...c, src, h: src ? logoHeight(src) : undefined };
});
---
<div class="client-marquee" role="region" aria-label="Clients we have worked with">
  <div class="client-track">
    {[0, 1].map((copy) => (
      <ul class="client-row" aria-hidden={copy === 1 ? 'true' : undefined}>
        {items.map((c) => (
          <li class="client-logo">
            {c.src
              ? <Image src={c.src} alt={copy === 0 ? c.name : ''} height={96} style={`height:${c.h}`} />
              : <span class="client-wordmark">{c.name}</span>}
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
{anon.length > 0 && <p class="client-footnote">Also: {anon.map((c) => c.name.replace(/^A /, 'a ')).join(', ')}{anon.some((c) => c.status === 'current') ? ' (current)' : ''}.</p>}
