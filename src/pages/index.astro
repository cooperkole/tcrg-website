---
import { withBase } from '../lib/paths';
import Base from '../layouts/Base.astro';
import StatsBand from '../components/StatsBand.astro';
import ClientRoster from '../components/ClientRoster.astro';
import ContactCta from '../components/ContactCta.astro';
import PhotoBand from '../components/PhotoBand.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import { Picture } from 'astro:assets';
import { photos } from '../data/photos';
import site from '../data/site.json';
import caseData from '../data/case-studies.json';
import placementData from '../data/placements.json';
import recruiting from '../data/recruiting.json';
import { lqip } from '../lib/lqip';

// Placements strip: every placement, grouped by path; within a group the "featured"
// names come first, in their featured order, then the rest alphabetically.
const pathLabels = { banking: 'Banking', consulting: 'Consulting', investing: 'Investing' } as const;
const rank = (n: string) => { const i = placementData.featured.indexOf(n); return i < 0 ? 999 : i; };
const placementGroups = (Object.keys(pathLabels) as (keyof typeof pathLabels)[]).map((key) => ({
  key,
  label: pathLabels[key],
  names: placementData.placements
    .filter((p) => p.path === key)
    .map((p) => p.name)
    .sort((a, b) => rank(a) - rank(b) || a.localeCompare(b)),
}));
// Blur-up placeholder painted under the hero photo (never a flat navy first paint).
const heroLqip = await lqip('boston-skyline-harbor-dusk.jpg');
const testimonials = site.testimonials.items as { quote: string; attribution: string }[];
const r = recruiting.recruiting;
---
<Base title="Tufts Capital Research Group | Pro bono market due diligence" description="A student-run group at Tufts University producing bespoke, pro bono market due diligence for private equity firms, endowments and investment advisors." heroOverlay>
  <section class="hero">
    <div class="hero-media">
      <div class="hero-lqip" aria-hidden="true" style={`background-image:url(${heroLqip});background-position:${photos.bostonDusk.focus ?? 'center'}`}></div>
      <Picture
        src={photos.bostonDusk.src}
        alt={photos.bostonDusk.alt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 1920]}
        quality={55}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        style={`object-position: ${photos.bostonDusk.focus}`}
      />
    </div>
    <div class="container hero-content">
      <p class="eyebrow">Student-run at Tufts University</p>
      <h1 transition:name="page-title">Bespoke market due diligence for institutional investors, from Tufts.</h1>
      <p class="hero-sub">Pro bono, semester-long engagements for private equity firms, endowments and investment advisors.</p>
      <p class="hero-credit"><PhotoCredit photo={photos.bostonDusk} /></p>
    </div>
  </section>

  <StatsBand />

  <section class="statement-band" aria-label="What a TCRG engagement is">
    <div class="container">
      <p class="statement" data-statement>{site.statement}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Clients</p>
      <h2>Who we have worked with</h2>
      <p class="lede">{site.summary}</p>
      <ClientRoster />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2>Three parts to every engagement</h2>
      <div class="pillars">
        {site.services.map((s) => (
          <div class="pillar">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">How it works</p>
        <h2>One semester, one vertical, one read-deck</h2>
        <p>{site.deliverable}</p>
        <a class="text-link" href={withBase('/work#process')}>See the engagement process</a>
      </div>
      <ol class="process-mini">
        {site.process.map((step) => <li>{step.title}</li>)}
      </ol>
    </div>
  </section>

  <PhotoBand photo={photos.customHouse} eyebrow={site.photoStatement.eyebrow} text={site.photoStatement.text} />

  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow">Selected work</p>
      <h2>Recent projects</h2>
      <ul class="work-cards">
        {caseData.caseStudies.map((c) => (
          <li>
            <a href={withBase(c.deck ? '/work/#sample' : '/work/#projects')}>
              <h3>{c.sector}</h3>
              {c.summary ? <p>{c.summary}</p> : <p class="case-placeholder">{c.placeholder}</p>}
              <span class="work-card-more">{c.deck ? 'Read the redacted deck' : 'More on Our Work'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="section">
      <div class="container">
        {testimonials.map((t) => (
          <figure class="testimonial">
            <blockquote>{t.quote}</blockquote>
            <figcaption>{t.attribution}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="section placements-band">
    <div class="container">
      <p class="eyebrow">Members</p>
      <h2>Where members go</h2>
      <p class="section-sub">{placementData.intro}</p>
    </div>
    <div class="hstrip" data-hstrip tabindex="0" role="region" aria-label="Member placements by path (scrolls sideways)">
      <div class="hstrip-track">
        {placementGroups.map((g) => (
          <div class="hstrip-group">
            <h3>{g.label}</h3>
            <ul>{g.names.map((n) => <li>{n}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
    <div class="container">
      <a class="text-link" href={withBase('/about#placements')}>All placements</a>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container ctas">
      <div class="cta">
        <p class="eyebrow">For investors</p>
        <h2>Have a market you want mapped?</h2>
        <p>{site.whatWeDo}</p>
        <ContactCta />
      </div>
      <div class="cta">
        <p class="eyebrow">For students</p>
        <h2>Join TCRG</h2>
        <p>{r.banner[r.status as keyof typeof r.banner]}</p>
        <a class="button button-light" href={withBase('/join')}>Recruiting details</a>
      </div>
    </div>
  </section>
</Base>
