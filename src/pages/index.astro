---
import Base from '../layouts/Base.astro';
import StatsBand from '../components/StatsBand.astro';
import ClientRoster from '../components/ClientRoster.astro';
import ContactCta from '../components/ContactCta.astro';
import PhotoBand from '../components/PhotoBand.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import { Picture } from 'astro:assets';
import { photos } from '../data/photos';
import site from '../data/site.json';
import caseData from '../data/case-studies.json';
import placementData from '../data/placements.json';
import recruiting from '../data/recruiting.json';

const paths = ['banking', 'consulting', 'investing'] as const;
const teaserPlacements = paths.flatMap((p) => placementData.placements.filter((x) => x.path === p).slice(0, 3));
const testimonials = site.testimonials.items as { quote: string; attribution: string }[];
const r = recruiting.recruiting;
---
<Base title="Tufts Capital Research Group" heroOverlay>
  <section class="hero">
    <div class="hero-media">
      <Picture
        src={photos.bostonDusk.src}
        alt={photos.bostonDusk.alt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 1920]}
        quality={55}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        style={`object-position: ${photos.bostonDusk.focus}`}
      />
    </div>
    <div class="container hero-content">
      <p class="eyebrow">Student-run at Tufts University</p>
      <h1>Bespoke market research for institutional investors, from Tufts.</h1>
      <p class="hero-sub">{site.tagline}</p>
    </div>
    <p class="hero-credit"><PhotoCredit photo={photos.bostonDusk} /></p>
  </section>

  <StatsBand />

  <section class="section">
    <div class="container">
      <p class="eyebrow">Clients</p>
      <h2>Who we have worked with</h2>
      <p class="lede">{site.summary}</p>
      <ClientRoster />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2>Three parts to every engagement</h2>
      <div class="pillars">
        {site.services.map((s) => (
          <div class="pillar">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">How it works</p>
        <h2>One semester, one vertical, one read-deck</h2>
        <p>{site.deliverable}</p>
        <a class="text-link" href="/work#process">See the engagement process</a>
      </div>
      <ol class="process-mini">
        {site.process.map((step) => <li>{step.title}</li>)}
      </ol>
    </div>
  </section>

  <PhotoBand photo={photos.customHouse} />

  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow">Selected work</p>
      <h2>Recent sectors</h2>
      <ul class="sector-list">
        {caseData.caseStudies.map((c) => (
          <li><a href="/work#projects">{c.sector}</a></li>
        ))}
      </ul>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="section">
      <div class="container">
        {testimonials.map((t) => (
          <figure class="testimonial">
            <blockquote>{t.quote}</blockquote>
            <figcaption>{t.attribution}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <p class="eyebrow">Members</p>
      <h2>Where members go</h2>
      <p>{placementData.intro}</p>
      <ul class="placement-teaser">
        {teaserPlacements.map((p) => <li>{p.name}</li>)}
      </ul>
      <a class="text-link" href="/about#placements">All placements</a>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container ctas">
      <div class="cta">
        <p class="eyebrow">For investors</p>
        <h2>Have a market you want mapped?</h2>
        <p>{site.whatWeDo}</p>
        <ContactCta />
      </div>
      <div class="cta">
        <p class="eyebrow">For students</p>
        <h2>Join TCRG</h2>
        <p>{r.banner[r.status as keyof typeof r.banner]}</p>
        <a class="button button-light" href="/join">Recruiting details</a>
      </div>
    </div>
  </section>
</Base>
