---
import Base from '../layouts/Base.astro';
import recruiting from '../data/recruiting.json';
import PhotoBand from '../components/PhotoBand.astro';
import { photos } from '../data/photos';

const r = recruiting.recruiting;
const banner = r.banner[r.status as keyof typeof r.banner];
// TBD dates render no date text at all.
const fmt = (d: string) => d === 'TBD' ? '' : new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const details = [
  { label: 'Who can apply', body: r.eligibility },
  { label: 'Application', body: r.application },
  { label: 'Time commitment', body: r.commitment },
  { label: 'How teams work', body: r.cadence },
];
---
<Base title="Join | Tufts Capital Research Group" description={`${r.cycle} recruiting for Tufts Capital Research Group: who we look for, the timeline and how to apply.`}>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Join</p>
      <h1 transition:name="page-title">{r.cycle} recruiting</h1>
      <p class={`status-banner status-${r.status}`} role="status">{banner}</p>
      <div class="button-row">
        {r.status === 'open' && r.links.application && <a class="button" href={r.links.application} rel="noopener">Apply</a>}
        {r.links.elist && <a class="button button-secondary" href={r.links.elist} rel="noopener">Join the e-list</a>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <dl class="details">
        {details.map((d) => (
          <div class="detail"><dt>{d.label}</dt><dd>{d.body}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <PhotoBand photo={photos.beaconHill} />

  <section class="section section-alt" id="timeline">
    <div class="container">
      <h2>Timeline</h2>
      <ol class="timeline">
        {r.timeline.map((t) => (
          <li><span class="timeline-step">{t.step}</span>{fmt(t.date) && <span class="timeline-date">{fmt(t.date)}</span>}</li>
        ))}
      </ol>
    </div>
  </section>

  {r.links.coffeeChat && (
    <section class="section" id="coffee-chat">
      <div class="container narrow">
        <h2>Talk to us first</h2>
        <p>{r.coffeeChat}</p>
        <a class="button" href={r.links.coffeeChat} rel="noopener">Sign up for a coffee chat</a>
      </div>
    </section>
  )}
</Base>
