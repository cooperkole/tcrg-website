---
import { withBase } from '../lib/paths';
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Tufts Capital Research Group" noindex>
  <section class="page-head page-404">
    <div class="container narrow">
      <p class="eyebrow">404</p>
      <h1>This page doesn't exist.</h1>
      <p class="lede">The address may have changed when the site moved. Try one of these instead.</p>
      <ul class="not-found-links">
        <li><a href={withBase('/')}>Home</a></li>
        <li><a href={withBase('/work')}>Our Work</a></li>
        <li><a href={withBase('/about')}>About</a></li>
        <li><a href={withBase('/join')}>Join</a></li>
      </ul>
    </div>
  </section>
</Base>
