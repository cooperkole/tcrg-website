---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description?: string; heroOverlay?: boolean }
const { title, description = 'Tufts Capital Research Group: student-run, pro bono market due diligence for institutional investors.', heroOverlay = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body class:list={{ 'has-hero': heroOverlay }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Gentle fade-in of section content on scroll. Skipped entirely for
      // prefers-reduced-motion and without IntersectionObserver; content is
      // visible by default, so nothing depends on this script.
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!calm && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        const vh = window.innerHeight;
        document.querySelectorAll('main .section > .container, main .stats-band > .container').forEach((el) => {
          if (el.getBoundingClientRect().top < vh) return; // already on screen: leave as is
          el.classList.add('reveal');
          io.observe(el);
        });
      }
    </script>
  </body>
</html>
