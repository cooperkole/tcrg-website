---
import { withBase, stripBase } from '../lib/paths';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props { title: string; description?: string; heroOverlay?: boolean; noindex?: boolean }
const { title, description = 'Tufts Capital Research Group: student-run, pro bono market due diligence for institutional investors.', heroOverlay = false, noindex = false } = Astro.props;
// GitHub Pages serves each page as a folder and redirects /work to /work/, so the
// canonical (and the sitemap) use the trailing-slash form.
const path = Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(withBase('/og-image.jpg'), Astro.site).href;
const isHome = stripBase(Astro.url.pathname) === '/';
// Organization structured data (home page only). Email is added once it is set.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  alternateName: site.shortName,
  url: new URL(withBase('/'), Astro.site).href,
  logo: new URL(withBase('/brand/tcrg-logo.png'), Astro.site).href,
  description: site.summary,
  sameAs: [site.contact.linkedin, site.contact.instagram],
  ...(site.contact.email ? { email: site.contact.email } : {}),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0E1A2B" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tufts Capital Research Group logo over the Boston skyline at dusk" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Tufts Capital Research Group logo over the Boston skyline at dusk" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />}
  </head>
  <body class:list={{ 'has-hero': heroOverlay }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Gentle fade-in of section content on scroll. Skipped entirely for
      // prefers-reduced-motion and without IntersectionObserver; content is
      // visible by default, so nothing depends on this script.
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!calm && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        const vh = window.innerHeight;
        document.querySelectorAll('main .section > .container, main .stats-band > .container').forEach((el) => {
          if (el.getBoundingClientRect().top < vh) return; // already on screen: leave as is
          el.classList.add('reveal');
          io.observe(el);
        });
      }
    </script>
  </body>
</html>
